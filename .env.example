# Database - ganti sesuai PostgreSQL Anda
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monev_publikasi"

# NextAuth - generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-random-string-panjang"
NEXTAUTH_URL="http://localhost:3000"

# Storage produksi (isi nanti saat deploy, kosongkan dulu untuk lokal)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION=""
